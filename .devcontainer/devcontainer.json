{
  "name": "Debian Slim with Nix",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode", // Set to `root` to connect as root. https://aka.ms/vscode-remote/containers/non-root.

  "postCreateCommand": ".devcontainer/postCreateCommand",

  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      // "multiUser": false
    }
  },
  
  "workspaceMount": "",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "runArgs": [
    "-v", "${localWorkspaceFolder}:/workspaces/${localWorkspaceFolderBasename}:Z",
    // Allow X11 connections on SELinux-enabled hosts
    "--security-opt", "label=type:container_runtime_t",

    // Important part for WSLg with SELinux support
    "-v", "/tmp/.X11-unix:/tmp/.X11-unix:Z", 
    "-v", "/mnt/wslg:/mnt/wslg:Z"
  ],

  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}"
  }
}
